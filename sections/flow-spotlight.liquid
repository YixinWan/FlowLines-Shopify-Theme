<section class="flow-spot" id="product">
  <div class="flow-spot__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1500,1900,2400', sizes: '100vw', alt: section.settings.image_alt }}
    {% endif %}
  </div>
  <div class="flow-spot__shade"></div>
  <div class="flow-spot__content">
    <span>{{ section.settings.eyebrow | escape }}</span>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.description | escape }}</p>
    <a href="{{ section.settings.link }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
.flow-spot{position:relative;min-height:610px;background:#1e3446;color:#fff;overflow:hidden;display:flex;align-items:end}
.flow-spot__media,.flow-spot__shade{position:absolute;inset:0}.flow-spot__media img{width:100%;height:100%;object-fit:cover;object-position:center}.flow-spot__shade{background:linear-gradient(90deg,rgba(10,20,29,.78),rgba(10,20,29,.18) 60%,rgba(10,20,29,0))}
.flow-spot__content{position:relative;z-index:1;padding:75px max(42px,calc((100vw - 1230px)/2));max-width:740px}
.flow-spot__content span{font-size:13px;letter-spacing:.17em;text-transform:uppercase}.flow-spot__content h2{font-size:clamp(38px,5vw,68px);letter-spacing:-.04em;line-height:1.05;margin:18px 0}.flow-spot__content p{font-size:19px;line-height:1.5;max-width:35ch;margin-bottom:27px}.flow-spot__content a{display:inline-block;color:#fff;border:1px solid rgba(255,255,255,.75);padding:13px 25px;border-radius:99px;text-decoration:none;font-weight:600}.flow-spot__content a:hover{background:#fff;color:#202326}
@media(max-width:700px){.flow-spot{min-height:620px}.flow-spot__media img{object-position:60% center}.flow-spot__shade{background:linear-gradient(0deg,rgba(8,19,30,.85),rgba(8,19,30,.05) 85%)}.flow-spot__content{padding:50px 25px}.flow-spot__content h2{font-size:40px}.flow-spot__content p{font-size:16px}}
</style>
{% schema %}
{"name":"Flowlines spotlight","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"image_alt","label":"Image alternative text","default":"Flowlines projector guiding a drawing"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Flowlines drawing projector"},{"type":"text","id":"heading","label":"Headline","default":"A little guidance. A world of imagination."},{"type":"textarea","id":"description","label":"Description","default":"Bring your ideas to life on real paper, one creative step at a time."},{"type":"text","id":"button","label":"Button text","default":"Join the waitlist"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Flowlines spotlight"}]}
{% endschema %}

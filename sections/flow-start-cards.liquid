<section class="fl-start" id="flowlines-starter-guide" aria-labelledby="fl-start-heading-{{ section.id }}">
  <div class="fl-start__inner">
    <div class="fl-start__intro">
      <p class="fl-start__eyebrow">YOUR CREATIVE STARTS HERE</p>
      <h2 id="fl-start-heading-{{ section.id }}">Everything You Need to Create.</h2>
      <p>Draw, color, and create on real paper.</p>
    </div>
    <div class="fl-start__grid">
      <a class="fl-start__card" href="/#how-it-works" aria-label="Learn about the Flowlines drawing projector">
        <div class="fl-start__copy"><h3>Drawing Projector</h3><span class="fl-start__link">Explore <span aria-hidden="true">↗</span></span></div>
        <img src="{{ 'flowlines-projector-original-cutout.png' | file_img_url: '1000x' }}" width="1440" height="1080" alt="Original Flowlines silver drawing projector with detailed adjustable stand" loading="lazy">
      </a>
      <a class="fl-start__card" href="/#how-it-works" aria-label="Explore the guided drawing app">
        <div class="fl-start__copy"><h3>Guided Drawing App</h3><span class="fl-start__link">Explore <span aria-hidden="true">↗</span></span></div>
        <img src="{{ 'flowlines-tablet-paper-cutout.png' | file_img_url: '1000x' }}" width="1440" height="1080" alt="Tablet showing guided flower drawing beside a single matching painted paper sheet" loading="lazy">
      </a>
      <a class="fl-start__card" href="/#faq" aria-label="Learn which art materials can be used with Flowlines">
        <div class="fl-start__copy"><h3>Art Materials</h3><span class="fl-start__link">Complete creative kit <span aria-hidden="true">↗</span></span></div>
        {{ 'flowlines-complete-art-kit.png' | file_img_url: '1000x' | img_tag: 'Complete art materials kit with markers, crayons, colored pencils, paints and brushes', 'fl-start__materials-image' }}
      </a>
    </div>
  </div>
</section>
<style>
.fl-start{background:#fff;padding:84px 28px 100px;color:#161616}
.fl-start__inner{max-width:1480px;margin:0 auto}
.fl-start__intro{text-align:center;margin:0 auto 48px;max-width:1100px}
.fl-start__eyebrow{font-size:12px;font-weight:700;letter-spacing:.19em;color:#d97757;margin:0 0 17px}
.fl-start__intro h2{font-size:clamp(31px,3vw,48px);font-weight:750;letter-spacing:-.045em;line-height:1.11;margin:0 0 18px}
.fl-start__intro>p:last-child{color:#676767;font-size:17px;margin:0}
.fl-start__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.fl-start__card{position:relative;display:block;overflow:hidden;min-height:555px;border-radius:18px;background:#fff;border:1px solid #ededed;text-align:center;color:#111;text-decoration:none;isolation:isolate;transition:transform .25s,box-shadow .25s}
.fl-start__card::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 93% 34% at 48% 107%,transparent 61%,rgba(174,183,188,.55) 61.25%,rgba(174,183,188,.55) 61.8%,transparent 62%),radial-gradient(ellipse 88% 37% at 52% 109%,transparent 72%,rgba(174,183,188,.42) 72.25%,rgba(174,183,188,.42) 72.75%,transparent 73%),radial-gradient(ellipse 97% 41% at 49% 112%,transparent 84%,rgba(174,183,188,.30) 84.25%,rgba(174,183,188,.30) 84.7%,transparent 85%),linear-gradient(155deg,#fff 35%,#f8f9f9 100%)}
.fl-start__card:hover{transform:translateY(-5px);box-shadow:0 16px 32px rgba(0,0,0,.08)}
.fl-start__copy{position:relative;z-index:2;padding:45px 16px 0}

.fl-start__card h3{font-size:clamp(23px,2.05vw,32px);line-height:1.18;letter-spacing:-.035em;font-weight:750;margin:0 0 15px}
.fl-start__link{font-size:14px;font-weight:600;color:#d87550}
.fl-start__card img{position:absolute;bottom:0;left:4%;width:92%;height:68%;object-fit:contain;object-position:center bottom;transition:transform .45s}
.fl-start__card:hover img{transform:scale(1.035)}
.fl-start__card:nth-child(1) img{height:76%}.fl-start__card:nth-child(2) img{width:96%;left:2%;height:68%;object-fit:contain;object-position:center bottom}.fl-start__card:nth-child(3) img{object-position:center bottom}
@media(max-width:1000px){.fl-start{padding:64px 20px 75px}.fl-start__grid{gap:15px}.fl-start__card{min-height:470px}.fl-start__copy{padding-top:30px}.fl-start__card img{height:65%}}
@media(max-width:749px){.fl-start{padding:55px 16px 65px}.fl-start__intro{margin-bottom:30px}.fl-start__intro h2{font-size:32px}.fl-start__intro h2 br{display:none}.fl-start__intro>p:last-child{font-size:15px}.fl-start__grid{grid-template-columns:1fr;gap:18px}.fl-start__card{min-height:455px}.fl-start__card h3{font-size:29px}.fl-start__card img{height:65%}}
@media(prefers-reduced-motion:reduce){.fl-start__card,.fl-start__card img{transition:none}}
</style>
{% schema %}
{"name":"Flowlines starter cards","settings":[],"presets":[{"name":"Flowlines starter cards"}]}
{% endschema %}

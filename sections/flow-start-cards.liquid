<section class="fl-start" id="flowlines-starter-guide" aria-labelledby="fl-start-heading-{{ section.id }}">
  <div class="fl-start__inner">
    <div class="fl-start__intro">
      <p class="fl-start__eyebrow">FROM IDEA TO ARTWORK</p>
      <h2 id="fl-start-heading-{{ section.id }}">Make It Real, One Step at a Time.</h2>
      <p>Choose an idea. Follow the guidance. Make it yours.</p>
    </div>
    <div class="fl-start__grid">
      <a class="fl-start__card" href="/#how-it-works" aria-label="Learn about the Flowlines drawing projector">
        <div class="fl-start__copy"><h3>Drawing Projector</h3><span class="fl-start__link">Explore <span aria-hidden="true">↗</span></span></div>
        <img src="{{ 'flowlines-projector-new-front.png' | file_img_url: '1000x' }}" width="1440" height="1080" alt="Original Flowlines silver drawing projector with detailed adjustable stand" loading="lazy">
      </a>
      <a class="fl-start__card" href="/#how-it-works" aria-label="Explore the guided drawing app">
        <div class="fl-start__copy"><h3>Guided Drawing App</h3><span class="fl-start__link">Explore <span aria-hidden="true">↗</span></span></div>
        <img src="{{ 'flowlines-tablet-paper-premium-v2.png' | file_img_url: '1000x' }}" width="1440" height="1080" alt="Tablet showing guided flower drawing beside a single matching painted paper sheet" loading="lazy">
      </a>
      <a class="fl-start__card" href="/#faq" aria-label="Learn which art materials can be used with Flowlines">
        <div class="fl-start__copy"><h3>Art Materials</h3><span class="fl-start__link">Explore <span aria-hidden="true">↗</span></span></div>
        {{ 'flowlines-premium-art-kit-v2.png' | file_img_url: '1000x' | img_tag: 'Complete art materials kit with markers, crayons, colored pencils, paints and brushes', 'fl-start__materials-image' }}
      </a>
    </div>
  </div>
</section>
<style>
.fl-start{background:#fff;padding:84px 28px 100px;color:#161616}
.fl-start__inner{max-width:1480px;margin:0 auto}
.fl-start__intro{text-align:center;margin:0 auto 48px;max-width:1100px}
.fl-start__eyebrow{font-size:12px;font-weight:700;letter-spacing:.19em;color:#777e84;margin:0 0 17px}
.fl-start__intro h2{font-size:clamp(31px,3vw,48px);font-weight:750;letter-spacing:-.045em;line-height:1.11;margin:0 0 18px}
.fl-start__intro>p:last-child{color:#676767;font-size:17px;margin:0}
.fl-start__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.fl-start__card{position:relative;display:block;overflow:hidden;min-height:555px;border-radius:18px;background:linear-gradient(145deg,#f8f9fa 0%,#f0f3f5 57%,#e3e9ed 100%);border:1px solid #dbe2e7;text-align:center;color:#111;text-decoration:none;isolation:isolate;transition:transform .25s,box-shadow .25s}
.fl-start__card::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 93% 34% at 48% 107%,transparent 61%,rgba(142,158,170,.60) 61.25%,rgba(174,183,188,.55) 61.8%,transparent 62%),radial-gradient(ellipse 88% 37% at 52% 109%,transparent 72%,rgba(142,158,170,.48) 72.25%,rgba(174,183,188,.42) 72.75%,transparent 73%),radial-gradient(ellipse 97% 41% at 49% 112%,transparent 84%,rgba(142,158,170,.38) 84.25%,rgba(174,183,188,.30) 84.7%,transparent 85%),radial-gradient(ellipse 110% 54% at 50% 106%,rgba(133,150,163,.24) 0%,transparent 70%),linear-gradient(155deg,rgba(255,255,255,.38) 12%,rgba(228,234,240,.34) 100%)}
.fl-start__card:hover{transform:translateY(-5px);box-shadow:0 22px 42px rgba(44,65,77,.14)}
.fl-start__copy{position:relative;z-index:2;padding:45px 16px 0}

.fl-start__card h3{font-size:clamp(23px,2.05vw,32px);line-height:1.18;letter-spacing:-.035em;font-weight:750;margin:0 0 15px}
.fl-start__link{font-size:14px;font-weight:600;color:#5e6770}
.fl-start__card img{position:absolute;bottom:0;left:4%;width:92%;height:68%;object-fit:contain;object-position:center bottom;transition:transform .45s}
.fl-start__card:hover img{transform:scale(1.035)}
.fl-start__card:nth-child(1) img{height:84%}.fl-start__card:nth-child(2) img{width:96%;left:2%;height:76%;object-fit:contain;object-position:center bottom}.fl-start__card:nth-child(3) img{width:96%;left:2%;height:75%;object-position:center bottom}
@media(max-width:1000px){.fl-start{padding:64px 20px 75px}.fl-start__grid{gap:15px}.fl-start__card{min-height:470px}.fl-start__copy{padding-top:30px}.fl-start__card img{height:65%}}
@media(max-width:749px){.fl-start{padding:55px 16px 65px}.fl-start__intro{margin-bottom:30px}.fl-start__intro h2{font-size:32px}.fl-start__intro h2 br{display:none}.fl-start__intro>p:last-child{font-size:15px}.fl-start__grid{grid-template-columns:1fr;gap:18px}.fl-start__card{min-height:455px}.fl-start__card h3{font-size:29px}.fl-start__card img{height:65%}}
@media(prefers-reduced-motion:reduce){.fl-start__card,.fl-start__card img{transition:none}}
.fl-start__card:first-child{background:linear-gradient(148deg,#fafbfc 2%,#f0f3f5 47%,#d9e1e6 100%);border-color:#cdd9df;box-shadow:0 14px 36px rgba(41,62,75,.09)} .fl-start__card:first-child::after{content:"";position:absolute;z-index:0;width:72%;height:36%;border-radius:50%;left:14%;bottom:0;background:radial-gradient(ellipse,rgba(120,143,157,.20),transparent 72%);filter:blur(14px);pointer-events:none} .fl-start__card:first-child .fl-start__link{color:#d87550;font-weight:700} .fl-start__card:first-child .fl-start__link span{display:inline-block;transition:transform .2s} .fl-start__card:first-child:hover .fl-start__link span{transform:translate(2px,-2px)} .fl-start__card:focus-visible{outline:3px solid #d87550;outline-offset:4px} @media(max-width:749px){.fl-start__card:first-child img{height:79%}.fl-start__card:nth-child(2) img,.fl-start__card:nth-child(3) img{height:70%}}
</style>
{% schema %}
{"name":"Flowlines starter cards","settings":[],"presets":[{"name":"Flowlines starter cards"}]}
{% endschema %}

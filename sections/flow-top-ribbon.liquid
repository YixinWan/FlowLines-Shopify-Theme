<div class="fl-top-ribbon" role="region" aria-label="Flowlines brand announcement">
  <div class="fl-top-ribbon__inner">
    <span class="fl-top-ribbon__left" aria-hidden="true"><span class="fl-top-ribbon__spark"></span> FLOWLINES STUDIO</span>
    <span class="fl-top-ribbon__message">Make room for your imagination.</span>
    <a href="/#flowlines-starter-guide" class="fl-top-ribbon__link">Explore Flowlines <span aria-hidden="true">↗</span></a>
  </div>
</div>
<style>
.fl-top-ribbon{background:#7b7167;color:#fff;width:100%;font-family:inherit}
.fl-top-ribbon__inner{max-width:1480px;margin:auto;min-height:42px;padding:0 32px;display:grid;grid-template-columns:1fr 2fr 1fr;align-items:center;gap:16px}
.fl-top-ribbon__left{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:700;letter-spacing:.17em;color:#f0e9e2;white-space:nowrap}
.fl-top-ribbon__spark{width:7px;height:7px;background:#d87550;border-radius:50%;box-shadow:0 0 0 4px rgba(216,117,80,.13)}
.fl-top-ribbon__message{text-align:center;font-size:12px;letter-spacing:.035em;font-weight:550}
.fl-top-ribbon__link{justify-self:end;color:#f5eee7;text-decoration:none;font-size:11px;font-weight:600;white-space:nowrap}
.fl-top-ribbon__link:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}
.fl-top-ribbon__link:focus-visible{outline:2px solid #e2a88f;outline-offset:4px}
#header-group > .shopify-section:has(.fl-top-ribbon){position:sticky;top:0;z-index:100}
#header-group > .header-section:has(> #header-component[sticky="always"]){top:41px;z-index:99}
#header-component[transparent][data-sticky-state="active"] .header__underlay-closed{height:100%;background:#fff}
#header-component[transparent][data-sticky-state="active"] .header__row{--color-foreground:#17232c;--color-foreground-rgb:23,35,44;--color-border:#17232c;--color-border-rgb:23,35,44;--color-account-icon:#17232c}
#header-component[transparent][data-sticky-state="active"]{--header-logo-display:block;--header-logo-inverse-display:none}
#header-component[transparent][data-sticky-state="active"] .flow-header-nav a{color:#17232c}
@media(max-width:749px){.fl-top-ribbon__inner{min-height:36px;padding:0 14px;display:flex;justify-content:center}.fl-top-ribbon__message{font-size:11px}.fl-top-ribbon__left,.fl-top-ribbon__link{display:none}#header-group > .header-section:has(> #header-component[sticky="always"]){top:35px}}
</style>
{% schema %}
{"name":"Flowlines top ribbon","settings":[],"presets":[{"name":"Flowlines top ribbon"}],"enabled_on":{"groups":["header"]}}
{% endschema %}

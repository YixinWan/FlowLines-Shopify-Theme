<section class="fl-videos" id="fl-videos-{{ section.id }}" aria-label="Flowlines video gallery">
  <div class="fl-videos__heading"><p>IN MOTION</p><h2>Creativity in every frame.</h2></div>
  <div class="fl-videos__viewport"><div class="fl-videos__track">
<button type="button" class="fl-videos__card" data-index="0" aria-label="Show video 1"><video muted loop playsinline preload="metadata" data-start="0" poster="{{ 'flowlines-projector-studio.png' | asset_url }}"><source src="https://cdn.shopify.com/videos/c/o/v/a5a3decb2239497c99821416d35cd661.mp4" type="video/mp4"></video><span>01 / The creative flow</span></button>
<button type="button" class="fl-videos__card" data-index="1" aria-label="Show video 2"><video muted loop playsinline preload="metadata" data-start="3" poster="{{ 'flowlines-guided-drawing-app.png' | asset_url }}"><source src="https://cdn.shopify.com/videos/c/o/v/a5a3decb2239497c99821416d35cd661.mp4" type="video/mp4"></video><span>02 / Sketch & explore</span></button>
<button type="button" class="fl-videos__card" data-index="2" aria-label="Show video 3"><video muted loop playsinline preload="metadata" data-start="6" poster="{{ 'flowlines-projector-studio.png' | asset_url }}"><source src="https://cdn.shopify.com/videos/c/o/v/a5a3decb2239497c99821416d35cd661.mp4" type="video/mp4"></video><span>03 / Make it real</span></button>
<button type="button" class="fl-videos__card" data-index="3" aria-label="Show video 4"><video muted loop playsinline preload="metadata" data-start="9" poster="{{ 'flowlines-guided-drawing-app.png' | asset_url }}"><source src="https://cdn.shopify.com/videos/c/o/v/a5a3decb2239497c99821416d35cd661.mp4" type="video/mp4"></video><span>04 / Creative moments</span></button>
  </div></div>
  <div class="fl-videos__dots" aria-label="Select a video"><button type="button" data-dot="0" aria-label="Show video 1"></button><button type="button" data-dot="1" aria-label="Show video 2"></button><button type="button" data-dot="2" aria-label="Show video 3"></button><button type="button" data-dot="3" aria-label="Show video 4"></button></div>
</section>
<style>
.fl-videos{padding:90px 0 92px;background:#fff;overflow:hidden;color:#172d3b}
.fl-videos__heading{text-align:center;margin:0 20px 32px}.fl-videos__heading p{font-size:11px;letter-spacing:.2em;font-weight:800;color:#d87550;margin:0 0 11px}.fl-videos__heading h2{font-size:clamp(34px,4vw,56px);line-height:1.1;letter-spacing:-.05em;margin:0}
.fl-videos__viewport{width:100%;overflow:visible}.fl-videos__track{display:flex;align-items:center;gap:22px;transition:transform .75s cubic-bezier(.2,.75,.2,1);will-change:transform}
.fl-videos__card{position:relative;flex:0 0 min(72vw,1040px);aspect-ratio:16/8.5;display:block;border:0;padding:0;overflow:hidden;border-radius:26px;background:#182c3b;cursor:pointer;opacity:.57;transform:scale(.84);transition:transform .7s cubic-bezier(.2,.75,.2,1),opacity .7s,box-shadow .7s;box-shadow:0 8px 25px #203c4a12}
.fl-videos__card.is-active{opacity:1;transform:scale(1);box-shadow:0 22px 55px #102b3c2b}.fl-videos__card video{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}.fl-videos__card:hover video{transform:scale(1.045)}.fl-videos__card:focus-visible{outline:4px solid #d87550;outline-offset:5px}
.fl-videos__card span{position:absolute;left:26px;bottom:23px;border-radius:40px;background:#ffffffe8;padding:12px 19px;font-size:14px;font-weight:750;color:#253a48;box-shadow:0 5px 20px #102c3820;pointer-events:none}
.fl-videos__dots{display:flex;justify-content:center;gap:10px;margin-top:26px}.fl-videos__dots button{border:0;padding:0;width:9px;height:9px;border-radius:15px;background:#cad4da;cursor:pointer;transition:width .25s,background .25s}.fl-videos__dots button.is-active{width:35px;background:#d87550}
@media(max-width:749px){.fl-videos{padding:62px 0}.fl-videos__track{gap:12px}.fl-videos__card{flex-basis:85vw;aspect-ratio:4/3;border-radius:18px}.fl-videos__card span{left:13px;bottom:13px;padding:9px 12px;font-size:12px}}
@media(prefers-reduced-motion:reduce){.fl-videos__track,.fl-videos__card,.fl-videos__card video{transition:none!important}}
</style>
<script>
(()=>{const root=document.getElementById('fl-videos-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';
const cards=Array.from(root.querySelectorAll('[data-index]'));const dots=Array.from(root.querySelectorAll('[data-dot]'));const viewport=root.querySelector('.fl-videos__viewport');const track=root.querySelector('.fl-videos__track');const reduced=matchMedia('(prefers-reduced-motion: reduce)');let index=0;let timer=0;let hovered=false;
cards.forEach((card,i)=>{const video=card.querySelector('video');video.addEventListener('loadedmetadata',()=>{const start=Number(video.dataset.start||0);if(video.duration>start+1)video.currentTime=start},{once:true});card.addEventListener('click',()=>select(i===index?(index+1)%cards.length:i))});
dots.forEach((dot,i)=>dot.addEventListener('click',()=>select(i)));
function paint(){const target=cards[index];track.style.transform='translate3d('+((viewport.clientWidth-target.offsetWidth)/2-target.offsetLeft)+'px,0,0)';cards.forEach((card,i)=>{const active=i===index;card.classList.toggle('is-active',active);card.setAttribute('aria-pressed',String(active));const video=card.querySelector('video');if(active&&!hovered&&!document.hidden&&!reduced.matches)video.play().catch(()=>{});else video.pause()});dots.forEach((dot,i)=>dot.classList.toggle('is-active',i===index))}
function run(){clearInterval(timer);if(!hovered&&!reduced.matches&&!document.hidden)timer=setInterval(()=>{index=(index+1)%cards.length;paint()},8500)}
function select(i){index=i;paint();run()}
viewport.addEventListener('mouseenter',()=>{hovered=true;clearInterval(timer);cards.forEach(card=>card.querySelector('video').pause())});viewport.addEventListener('mouseleave',()=>{hovered=false;paint();run()});
window.addEventListener('resize',paint);document.addEventListener('visibilitychange',()=>{paint();run()});paint();run();
})();
</script>

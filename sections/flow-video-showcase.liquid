<section class="fl-film" id="flowlines-film-{{ section.id }}" aria-label="Flowlines product video">
  <div class="fl-film__inner">
    <div class="fl-film__stage">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'fl-film__video', image_size: '1800x' }}
        <button class="fl-film__toggle" type="button" aria-pressed="false" aria-label="Pause video"><span aria-hidden="true">Ⅱ</span></button>
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width: 2000 | image_tag: class: 'fl-film__poster', loading: 'lazy', widths: '750,1100,1500,2000', sizes: '100vw' }}
      {% else %}
        <div class="fl-film__empty" aria-label="Video showcase awaiting a video upload"></div>
      {% endif %}
    </div>
  </div>
</section>
<style>
#flowlines-film-{{ section.id }}{background:#f6f7f7;padding:0}
#flowlines-film-{{ section.id }} .fl-film__inner{width:100%;max-width:none;margin:0}
#flowlines-film-{{ section.id }} .fl-film__stage{position:relative;overflow:hidden;background:#e8eaec;border-radius:0;width:100%;height:100svh;min-height:620px}
#flowlines-film-{{ section.id }} .fl-film__video,#flowlines-film-{{ section.id }} .fl-film__poster{display:block;width:100%;height:100%;object-fit:contain}
#flowlines-film-{{ section.id }} .fl-film__empty{height:100%;background:linear-gradient(130deg,#ebedef,#d9dfe2)}
#flowlines-film-{{ section.id }} .fl-film__toggle{position:absolute;right:19px;bottom:19px;z-index:3;border:1px solid #d3d6d8;background:#fff;color:#202326;border-radius:99px;min-width:44px;min-height:44px;padding:9px 12px;font:inherit;font-size:13px;cursor:pointer;transition:transform .15s cubic-bezier(.16,1,.3,1),background .15s}
#flowlines-film-{{ section.id }} .fl-film__toggle:hover{background:#f2f4f5}
#flowlines-film-{{ section.id }} .fl-film__toggle:active{transform:scale(.95)}
#flowlines-film-{{ section.id }} .fl-film__toggle:focus-visible{outline:3px solid #d97757;outline-offset:3px}
@media(max-width:749px){#flowlines-film-{{ section.id }}{padding:0}#flowlines-film-{{ section.id }} .fl-film__stage{height:75svh;min-height:430px;border-radius:0}#flowlines-film-{{ section.id }} .fl-film__video,#flowlines-film-{{ section.id }} .fl-film__poster{object-fit:cover}}
</style>
<script>
(() => {
 const root=document.getElementById('flowlines-film-{{ section.id }}');
 if(!root || root.dataset.motionReady)return;
 root.dataset.motionReady='true';
 const video=root.querySelector('video'),button=root.querySelector('.fl-film__toggle');
 if(!video || !button)return;
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 let userPaused=false;
 const sync=()=>{
   const shouldPause=userPaused||reduced.matches||document.hidden;
   if(shouldPause)video.pause();else video.play().catch(()=>{});
   button.setAttribute('aria-pressed',String(shouldPause));
   button.setAttribute('aria-label',shouldPause?'Play video':'Pause video');
   button.innerHTML=shouldPause?'<span aria-hidden="true">▶</span>':'<span aria-hidden="true">Ⅱ</span>';
 };
 button.addEventListener('click',()=>{userPaused=!userPaused;sync()});
 document.addEventListener('visibilitychange',sync);
 if(reduced.addEventListener)reduced.addEventListener('change',sync);
 sync();
})();
</script>
{% schema %}
{"name":"Flowlines video showcase","settings":[{"type":"video","id":"video","label":"Autoplay showcase video"},{"type":"image_picker","id":"poster","label":"Preview image shown before a video is selected"}],"presets":[{"name":"Flowlines video showcase"}]}
{% endschema %}

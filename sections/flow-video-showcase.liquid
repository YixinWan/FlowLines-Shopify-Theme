<section class="fl-film" id="flowlines-film-{{ section.id }}" aria-labelledby="fl-film-title-{{ section.id }}">
  <div class="fl-film__inner">
    <div class="fl-film__head">
      <div>
        <h2 id="fl-film-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
      {% if section.settings.video != blank %}<button class="fl-film__toggle" type="button" aria-pressed="false" aria-label="Pause video">Pause <span aria-hidden="true">Ⅱ</span></button>{% endif %}
    </div>
    <div class="fl-film__stage">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'fl-film__video', image_size: '1800x' }}
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width: 2000 | image_tag: class: 'fl-film__poster', loading: 'lazy', widths: '750,1100,1500,2000', sizes: '100vw' }}
      {% else %}
        <div class="fl-film__empty" aria-label="Video showcase awaiting a video upload"><span>FLOWLINES</span></div>
      {% endif %}
      {% if section.settings.video == blank %}<span class="fl-film__placeholder">{{ section.settings.placeholder_text | escape }}</span>{% endif %}
    </div>
  </div>
</section>
<style>
#flowlines-film-{{ section.id }}{background:#fff;padding:0 28px 100px;color:#17191b}
#flowlines-film-{{ section.id }} .fl-film__inner{max-width:1480px;margin:0 auto}
#flowlines-film-{{ section.id }} .fl-film__head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:26px}
#flowlines-film-{{ section.id }} h2{font-size:clamp(30px,3.5vw,52px);letter-spacing:-.045em;line-height:1.1;margin:0 0 12px;font-weight:750}
#flowlines-film-{{ section.id }} .fl-film__head p{font-size:16px;color:#65676a;margin:0}
#flowlines-film-{{ section.id }} .fl-film__stage{position:relative;overflow:hidden;background:#e8eaec;border-radius:18px;aspect-ratio:16/8.3}
#flowlines-film-{{ section.id }} .fl-film__video,#flowlines-film-{{ section.id }} .fl-film__poster{display:block;width:100%;height:100%;object-fit:cover}
#flowlines-film-{{ section.id }} .fl-film__empty{height:100%;display:grid;place-items:center;background:linear-gradient(130deg,#ebedef,#d9dfe2)}
#flowlines-film-{{ section.id }} .fl-film__empty span{color:#9ca5aa;font-size:clamp(28px,7vw,100px);font-weight:750;letter-spacing:-.05em}
#flowlines-film-{{ section.id }} .fl-film__placeholder{position:absolute;left:30px;bottom:28px;color:#fff;background:rgba(24,27,30,.64);border-radius:30px;padding:10px 18px;font-size:13px;letter-spacing:.02em}
#flowlines-film-{{ section.id }} .fl-film__toggle{border:1px solid #d3d6d8;background:#fff;color:#202326;border-radius:99px;min-width:102px;padding:11px 17px;font:inherit;font-size:13px;cursor:pointer;transition:transform .15s cubic-bezier(.16,1,.3,1),background .15s}
#flowlines-film-{{ section.id }} .fl-film__toggle:hover{background:#f2f4f5}
#flowlines-film-{{ section.id }} .fl-film__toggle:active{transform:scale(.95)}
#flowlines-film-{{ section.id }} .fl-film__toggle:focus-visible{outline:3px solid #d97757;outline-offset:3px}
@media(max-width:749px){#flowlines-film-{{ section.id }}{padding:0 16px 65px}#flowlines-film-{{ section.id }} .fl-film__head{align-items:flex-start;margin-bottom:19px}#flowlines-film-{{ section.id }} .fl-film__stage{aspect-ratio:4/3;border-radius:14px}#flowlines-film-{{ section.id }} .fl-film__head p{font-size:14px}#flowlines-film-{{ section.id }} .fl-film__placeholder{left:15px;bottom:15px;font-size:11px;padding:8px 12px}}
</style>
<script>
(() => {
 const root=document.getElementById('flowlines-film-{{ section.id }}');
 if(!root || root.dataset.motionReady)return;
 root.dataset.motionReady='true';
 const video=root.querySelector('video'),button=root.querySelector('.fl-film__toggle');
 if(!video || !button)return;
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 let userPaused=false;
 const sync=()=>{
   const shouldPause=userPaused||reduced.matches||document.hidden;
   if(shouldPause)video.pause();else video.play().catch(()=>{});
   button.setAttribute('aria-pressed',String(shouldPause));
   button.setAttribute('aria-label',shouldPause?'Play video':'Pause video');
   button.innerHTML=shouldPause?'Play <span aria-hidden="true">▶</span>':'Pause <span aria-hidden="true">Ⅱ</span>';
 };
 button.addEventListener('click',()=>{userPaused=!userPaused;sync()});
 document.addEventListener('visibilitychange',sync);
 if(reduced.addEventListener)reduced.addEventListener('change',sync);
 sync();
})();
</script>
{% schema %}
{"name":"Flowlines video showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"See Flowlines in Action"},{"type":"text","id":"subheading","label":"Description","default":"From your first outline to a finished piece of art."},{"type":"video","id":"video","label":"Autoplay showcase video"},{"type":"image_picker","id":"poster","label":"Preview image shown before a video is selected"},{"type":"text","id":"placeholder_text","label":"Preview label","default":"A closer look at Flowlines"}],"presets":[{"name":"Flowlines video showcase"}]}
{% endschema %}

<section class="fl-film" id="flowlines-film-{{ section.id }}" aria-label="Flowlines motion showcase">
  <div class="fl-film__stage">
    {% if section.settings.display_mode == 'video' and section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'fl-film__video', image_size: '1800x' }}
    {% else %}
      <svg class="fl-film__art" viewBox="0 0 1440 810" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="fl-bg-{{ section.id }}" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#122638"/><stop offset=".55" stop-color="#1b3447"/><stop offset="1" stop-color="#274052"/></linearGradient>
          <linearGradient id="fl-pink-{{ section.id }}" x1="0" x2="1"><stop stop-color="#f7a895"/><stop offset="1" stop-color="#df7f78"/></linearGradient>
          <linearGradient id="fl-gold-{{ section.id }}" x1="0" x2="1"><stop stop-color="#e9bf81"/><stop offset="1" stop-color="#f4d399"/></linearGradient>
          <linearGradient id="fl-blue-{{ section.id }}" x1="0" x2="1"><stop stop-color="#65a9c4"/><stop offset="1" stop-color="#b6d9d6"/></linearGradient>
        </defs>
        <rect width="1440" height="810" fill="url(#fl-bg-{{ section.id }})"/>
        <circle cx="1150" cy="160" r="390" fill="#abc8c7" opacity=".055"/>
        <circle cx="180" cy="720" r="350" fill="#f0b5aa" opacity=".06"/>
        <g data-fl-motion="1" fill="none" stroke-linecap="round">
          <path d="M-180 570 C 140 40, 370 102, 605 390 S 1080 710, 1640 160" stroke="url(#fl-blue-{{ section.id }})" stroke-width="92" opacity=".14"/>
          <path d="M-150 600 C 200 160, 355 120, 650 430 S 1150 690, 1610 150" stroke="url(#fl-blue-{{ section.id }})" stroke-width="2.5" opacity=".83"/>
        </g>
        <g data-fl-motion="2" fill="none" stroke-linecap="round">
          <path d="M-180 720 C 170 420, 365 220, 650 420 S 1130 580, 1610 290" stroke="url(#fl-pink-{{ section.id }})" stroke-width="64" opacity=".20"/>
          <path d="M-180 720 C 170 420, 365 220, 650 420 S 1130 580, 1610 290" stroke="url(#fl-pink-{{ section.id }})" stroke-width="3" opacity=".92"/>
        </g>
        <g data-fl-motion="3" fill="none" stroke-linecap="round">
          <path d="M-180 220 C 220 670, 410 710, 685 380 S 1160 110, 1590 610" stroke="url(#fl-gold-{{ section.id }})" stroke-width="49" opacity=".16"/>
          <path d="M-180 220 C 220 670, 410 710, 685 380 S 1160 110, 1590 610" stroke="url(#fl-gold-{{ section.id }})" stroke-width="3" opacity=".92"/>
        </g>
        <g data-fl-motion="4" fill="none" stroke-linecap="round">
          <path d="M-150 370 C 300 120, 485 690, 815 410 S 1170 160, 1630 560" stroke="#d6e5db" stroke-width="2" opacity=".45"/>
          <path d="M-150 410 C 300 160, 485 730, 815 450 S 1170 200, 1630 600" stroke="#d6e5db" stroke-width="1.5" opacity=".27"/>
        </g>
      </svg>
    {% endif %}
    <button class="fl-film__toggle" type="button" aria-pressed="false" aria-label="Pause animation"><span aria-hidden="true">Ⅱ</span></button>
  </div>
</section>
<style>
#flowlines-film-{{ section.id }}{padding:0;margin:0;background:#1b3447}
#flowlines-film-{{ section.id }} .fl-film__stage{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#1b3447}
#flowlines-film-{{ section.id }} .fl-film__video,#flowlines-film-{{ section.id }} .fl-film__art{display:block;width:100%;height:100%;object-fit:cover}
#flowlines-film-{{ section.id }} .fl-film__toggle{position:absolute;right:24px;bottom:24px;z-index:2;display:grid;place-items:center;border:1px solid rgba(255,255,255,.35);background:rgba(21,37,50,.4);color:#fff;backdrop-filter:blur(9px);width:44px;height:44px;border-radius:50%;cursor:pointer;transition:background .2s,transform .2s}
#flowlines-film-{{ section.id }} .fl-film__toggle:hover{background:rgba(21,37,50,.7)}
#flowlines-film-{{ section.id }} .fl-film__toggle:active{transform:scale(.95)}
#flowlines-film-{{ section.id }} .fl-film__toggle:focus-visible{outline:3px solid #efad8f;outline-offset:3px}
@media(max-width:749px){#flowlines-film-{{ section.id }} .fl-film__toggle{right:14px;bottom:14px}}
</style>
<script>
(() => {
  const root=document.getElementById('flowlines-film-{{ section.id }}');
  if(!root || root.dataset.motionReady)return;
  root.dataset.motionReady='true';
  const video=root.querySelector('video');
  const button=root.querySelector('.fl-film__toggle');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  const layers=Array.from(root.querySelectorAll('[data-fl-motion]'));
  const animationSpecs=[
    [[-26,-14],[24,11],12600],
    [[22,12],[-20,-16],10700],
    [[-16,16],[19,-10],14800],
    [[19,-12],[-24,15],11800]
  ];
  const animations=layers.map((el,i)=>{
    const spec=animationSpecs[i];
    return el.animate([
      {transform:`translate3d(${spec[0][0]}px,${spec[0][1]}px,0)`},
      {transform:`translate3d(${spec[1][0]}px,${spec[1][1]}px,0)`}
    ],{duration:spec[2],iterations:Infinity,direction:'alternate',easing:'ease-in-out'});
  });
  let userPaused=false;
  function sync(){
    const paused=userPaused||reduced.matches||document.hidden;
    animations.forEach(a=>paused?a.pause():a.play());
    if(video){if(paused)video.pause();else video.play().catch(()=>{});}
    button.setAttribute('aria-pressed',String(paused));
    button.setAttribute('aria-label',paused?'Play animation':'Pause animation');
    button.innerHTML=paused?'<span aria-hidden="true">▶</span>':'<span aria-hidden="true">Ⅱ</span>';
  }
  button.addEventListener('click',()=>{userPaused=!userPaused;sync()});
  document.addEventListener('visibilitychange',sync);
  if(reduced.addEventListener)reduced.addEventListener('change',sync);
  sync();
})();
</script>
{% schema %}
{"name":"Flowlines motion showcase","settings":[{"type":"select","id":"display_mode","label":"Display","options":[{"value":"animated_flow","label":"Smooth flowing lines"},{"value":"video","label":"Uploaded video"}],"default":"animated_flow"},{"type":"video","id":"video","label":"Optional uploaded video"}],"presets":[{"name":"Flowlines motion showcase"}]}
{% endschema %}

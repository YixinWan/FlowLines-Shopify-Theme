<section class="flow-duo" id="discover">
  <div class="flow-duo__heading">
    <p>{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="flow-duo__grid">
    {% for block in section.blocks %}
      <article class="flow-duo__card" {{ block.shopify_attributes }}>
        <div class="flow-duo__photo">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width: 780px) 50vw, 100vw', alt: block.settings.title }}
          {% endif %}
        </div>
        <div class="flow-duo__copy">
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.description | escape }}</p>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
<style>
.flow-duo{background:#ffffff;padding:88px max(28px,calc((100vw - 1320px)/2))}
.flow-duo__heading{text-align:center;margin-bottom:35px}.flow-duo__heading p{font-size:13px;letter-spacing:.17em;text-transform:uppercase;color:#bc7057}.flow-duo__heading h2{font-size:clamp(32px,4vw,52px);letter-spacing:-.035em;line-height:1.1;margin:9px 0;color:#242424}
.flow-duo__grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.flow-duo__card{overflow:hidden;border-radius:16px;background:#f1f0ed}.flow-duo__photo{aspect-ratio:1.33;overflow:hidden}.flow-duo__photo img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.flow-duo__card:hover .flow-duo__photo img{transform:scale(1.025)}
.flow-duo__copy{padding:30px 36px 35px}.flow-duo__copy h3{font-size:clamp(22px,2.3vw,30px);line-height:1.2;margin:0 0 10px;letter-spacing:-.02em}.flow-duo__copy p{font-size:16px;line-height:1.55;max-width:48ch;color:#5f6060;margin:0 0 20px}.flow-duo__copy a{font-weight:700;color:#202326;text-underline-offset:5px}
@media(max-width:700px){.flow-duo{padding:58px 18px}.flow-duo__grid{grid-template-columns:1fr;gap:18px}.flow-duo__copy{padding:24px}.flow-duo__photo{aspect-ratio:1.35}}
@media(prefers-reduced-motion:reduce){.flow-duo__photo img{transition:none}}
</style>
{% schema %}
{"name":"Flowlines stories","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A new way to create"},{"type":"text","id":"heading","label":"Headline","default":"The art of getting started."}],"blocks":[{"type":"story","name":"Photo story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Draw with confidence"},{"type":"textarea","id":"description","label":"Description","default":"An approachable creative experience from your first mark to your finished artwork."},{"type":"text","id":"link_label","label":"Link text","default":"Explore the process"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":2,"presets":[{"name":"Flowlines stories","blocks":[{"type":"story"},{"type":"story"}]}]}
{% endschema %}

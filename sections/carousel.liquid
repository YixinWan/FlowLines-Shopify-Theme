

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-carousel
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: 12 %}
  "
  data-testid="carousel-section"
>
  {% content_for 'block', type: 'group', id: 'static-header' %}

  {% content_for 'block', type: '_carousel-content', id: 'static-carousel-content', closest.product: null %}
</div>

{% if section.settings.auto_scroll %}
<script>
  (() => {
    const viewport = document.querySelector('#shopify-section-{{ section.id }} [data-flow-marquee]');
    if (!viewport) return;
    const track = viewport.querySelector('.flow-marquee-track');
    const originals = Array.from(track.children);
    if (!originals.length) return;
    const copies = originals.map((card) => {
      const copy = card.cloneNode(true);
      copy.setAttribute('aria-hidden', 'true');
      copy.setAttribute('data-flow-copy', '');
      copy.style.pointerEvents = 'none';
      copy.querySelectorAll('[id], [ref], [data-shopify-editor-block]').forEach((node) => {
        node.removeAttribute('id');
        node.removeAttribute('ref');
        node.removeAttribute('data-shopify-editor-block');
      });
      copy.removeAttribute('id');
      copy.removeAttribute('ref');
      track.appendChild(copy);
      return copy;
    });
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animation;
    let hovered = false;
    const setup = () => {
      animation?.cancel();
      const columns = window.innerWidth < 750 ? {{ section.settings.mobile_columns | default: '2' }} : {{ section.settings.columns }};
      const gap = {{ section.settings.columns_gap | default: 12 }};
      const width = Math.max(110, (window.innerWidth - gap * (columns + 1)) / columns);
      originals.concat(copies).forEach((card) => {
        card.style.flex = '0 0 auto';
        card.style.width = width + 'px';
        card.style.height = 'auto';
      });
      const distance = copies[0].offsetLeft - originals[0].offsetLeft;
      if (!motion.matches && distance > 0) {
        animation = track.animate(
          [{ transform: 'translate3d(0, 0, 0)' }, { transform: 'translate3d(-' + distance + 'px, 0, 0)' }],
          { duration: distance / {{ section.settings.continuous_speed }} * 1000, iterations: Infinity, easing: 'linear' }
        );
        if (hovered) animation.pause();
      } else {
        animation = null;
      }
    };
    viewport.addEventListener('mouseenter', () => { hovered = true; animation?.pause(); });
    viewport.addEventListener('mouseleave', () => { hovered = false; animation?.play(); });
    viewport.addEventListener('focusin', () => { hovered = true; animation?.pause(); });
    viewport.addEventListener('focusout', () => { hovered = false; animation?.play(); });
    window.addEventListener('resize', setup, { passive: true });
    motion.addEventListener?.('change', setup);
    requestAnimationFrame(setup);
  })();
</script>
{% endif %}

{% schema %}
{

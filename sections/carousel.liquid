  "settings": [
    {"type":"checkbox","id":"auto_scroll","label":"Automatically advance slides","default":false},
    {"type":"range","id":"continuous_speed","label":"Scroll speed (px per second)","min":20,"max":80,"step":5,"unit":"px","default":35},
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",

<section class="fl-outcome" id="flowlines-your-artwork" aria-labelledby="fl-outcome-title-{{ section.id }}">
  <div class="fl-outcome__inner">
    <div class="fl-outcome__copy">
      <span class="fl-outcome__eyebrow">THE JOY OF MAKING</span>
      <h2 id="fl-outcome-title-{{ section.id }}">From “I wish I could”<br>to <em>“I made this.”</em></h2>
      <p>Wherever inspiration takes you, the best part is making something with your own hands. From a first idea to a finished piece — it is yours.</p>
      <a href="/#waitlist" class="fl-outcome__cta">Be part of Flowlines <span aria-hidden="true">↗</span></a>
      <small>Illustrative artwork examples · Final creative experience may vary.</small>
    </div>
    <div class="fl-outcome__art">
      <figure class="fl-outcome__art-one">
        <img src="{{ 'flowlines-artwork-colorful-friends.png' | file_img_url: '900x' }}" alt="Colorful group portrait artwork inspiration" width="700" height="700" loading="lazy">
      </figure>
      <figure class="fl-outcome__art-two">
        <img src="{{ 'flowlines-artwork-yellow-flowers.png' | file_img_url: '700x' }}" alt="Vibrant handmade yellow flower artwork inspiration" width="550" height="550" loading="lazy">
      </figure>
      <span class="fl-outcome__scribble" aria-hidden="true">made by you.</span>
    </div>
  </div>
</section>
<style>
.fl-outcome{background:#f5f3f0;color:#202526;padding:110px 34px;overflow:hidden}
.fl-outcome__inner{max-width:1450px;margin:auto;display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:7vw;align-items:center}
.fl-outcome__eyebrow{font-size:12px;letter-spacing:.18em;font-weight:800;color:#b77e69}
.fl-outcome h2{font-size:clamp(38px,4.6vw,69px);line-height:1.08;letter-spacing:-.055em;margin:24px 0 26px;font-weight:760}
.fl-outcome h2 em{font-style:normal;color:#b77e69}
.fl-outcome__copy>p{font-size:clamp(16px,1.35vw,19px);line-height:1.62;color:#676967;max-width:560px;margin:0 0 28px}
.fl-outcome__cta{display:inline-flex;align-items:center;gap:24px;border-radius:99px;background:#252b2e;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:17px 25px;transition:transform .25s,background .25s}
.fl-outcome__cta:hover{background:#846e61;transform:translateY(-2px)}
.fl-outcome__copy small{display:block;color:#96918c;font-size:11px;line-height:1.4;margin-top:20px}
.fl-outcome__art{min-height:560px;position:relative;display:flex;align-items:center;justify-content:center}
.fl-outcome__art figure{margin:0;background:#fff;padding:12px;border-radius:8px;box-shadow:0 22px 55px rgba(59,55,52,.14);transition:transform .5s cubic-bezier(.2,.75,.2,1),box-shadow .5s}
.fl-outcome__art figure img{width:100%;height:100%;display:block;object-fit:cover;border-radius:3px}
.fl-outcome__art-one{width:61%;aspect-ratio:1/1.18;transform:rotate(-7deg) translate(-14%,5%)}
.fl-outcome__art-two{width:47%;aspect-ratio:1/1.1;position:absolute;right:0;top:17%;transform:rotate(8deg)}
.fl-outcome__art-one:hover{transform:rotate(-4deg) translate(-14%,0) scale(1.035);box-shadow:0 32px 65px rgba(59,55,52,.19)}
.fl-outcome__art-two:hover{transform:rotate(4deg) scale(1.035);box-shadow:0 32px 65px rgba(59,55,52,.19)}
.fl-outcome__scribble{position:absolute;right:5%;bottom:7%;font-size:18px;letter-spacing:.02em;font-style:italic;color:#9b8a7e;transform:rotate(-8deg)}
@media(max-width:900px){.fl-outcome{padding:80px 24px}.fl-outcome__inner{grid-template-columns:1fr;gap:35px}.fl-outcome__art{min-height:480px;max-width:650px;width:100%;margin:auto}}
@media(max-width:600px){.fl-outcome{padding:68px 20px}.fl-outcome h2{font-size:39px}.fl-outcome__art{min-height:330px}.fl-outcome__art figure{padding:7px}.fl-outcome__scribble{font-size:14px}.fl-outcome__copy>p{font-size:15px}}
@media(prefers-reduced-motion:reduce){.fl-outcome__art figure,.fl-outcome__cta{transition:none}}
</style>
{% schema %}
{"name":"From idea to artwork","settings":[],"presets":[{"name":"From idea to artwork"}]}
{% endschema %}

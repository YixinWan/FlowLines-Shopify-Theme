<section class="fl-pains" id="flowlines-creation-pains" aria-labelledby="fl-pains-title-{{ section.id }}">
  <div class="fl-pains__inner">
    <div class="fl-pains__intro">
      <p class="fl-pains__eyebrow">THE CREATIVE BLOCK</p>
      <h2 id="fl-pains-title-{{ section.id }}">You have the idea.<br><em>Where do you begin?</em></h2>
      <p>You want to make something that's truly yours. But turning an idea into a painting can feel harder than it should.</p>
    </div>
    <div class="fl-pains__grid">
      {% assign pain_titles = 'The blank page|Getting proportions right|Choosing the right colors|Knowing what to do next' | split: '|' %}
      {% assign pain_texts = "You know what you want to create — but that first line feels impossible.|The sketch doesn't quite match the picture in your head.|Beautiful colors are easy to imagine, harder to put together.|Too many tutorials. Not enough confidence to keep going." | split: '|' %}
      {% for i in (1..4) %}
        {% assign key = 'image_' | append: i %}
        {% assign img = section.settings[key] %}
        {% assign idx = forloop.index0 %}
        <article class="fl-pains__card">
          <div class="fl-pains__media">
            {% if img != blank %}
              {{ img | image_url: width: 850 | image_tag: loading: 'lazy', widths: '300,500,700,850', sizes: '(max-width: 749px) 80vw, 25vw', alt: pain_titles[idx] }}
            {% else %}
              <div class="fl-pains__fallback fl-pains__fallback--{{ i }}" aria-hidden="true"><span></span></div>
            {% endif %}
            <span class="fl-pains__number">0{{ i }}</span>
          </div>
          <h3>{{ pain_titles[idx] }}</h3>
          <p>{{ pain_texts[idx] }}</p>
        </article>
      {% endfor %}
    </div>
    <div class="fl-pains__outro">The hardest part is starting. <span>Flowlines helps you take the first step.</span><a href="{{ routes.root_url }}#flowlines-starter-guide">Discover your creative toolkit ↘</a></div>
  </div>
</section>
<style>
#flowlines-creation-pains{background:#f8f8f7;color:#20262a;padding:100px 34px 105px}
#flowlines-creation-pains .fl-pains__inner{max-width:1430px;margin:0 auto}
#flowlines-creation-pains .fl-pains__intro{text-align:center;max-width:930px;margin:0 auto 64px}
#flowlines-creation-pains .fl-pains__eyebrow{font-size:12px;letter-spacing:.18em;font-weight:700;color:#bd785f;margin:0 0 19px}
#flowlines-creation-pains h2{font-size:clamp(34px,4.4vw,65px);line-height:1.1;letter-spacing:-.045em;font-weight:720;margin:0 0 23px}
#flowlines-creation-pains h2 em{font-style:normal;color:#877a70}
#flowlines-creation-pains .fl-pains__intro>p:last-child{color:#64686b;font-size:clamp(15px,1.35vw,19px);line-height:1.65;max-width:730px;margin:0 auto}
#flowlines-creation-pains .fl-pains__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:19px}
#flowlines-creation-pains .fl-pains__card{min-width:0}
#flowlines-creation-pains .fl-pains__media{position:relative;aspect-ratio:4/4.7;overflow:hidden;border-radius:18px;background:#e6e6e4}
#flowlines-creation-pains .fl-pains__media img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(95%) brightness(.88);transition:filter .6s,transform .7s cubic-bezier(.2,.75,.2,1)}
#flowlines-creation-pains .fl-pains__card:hover img{filter:grayscale(15%) brightness(1);transform:scale(1.075)}
#flowlines-creation-pains .fl-pains__media:after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(transparent,rgba(20,25,30,.27));pointer-events:none}
#flowlines-creation-pains .fl-pains__number{position:absolute;left:20px;bottom:17px;z-index:1;color:#fff;font-size:13px;font-weight:700;letter-spacing:.08em}
#flowlines-creation-pains h3{font-size:clamp(17px,1.45vw,22px);letter-spacing:-.025em;line-height:1.2;margin:22px 0 10px;font-weight:700}
#flowlines-creation-pains .fl-pains__card>p{font-size:14px;line-height:1.55;color:#6d7071;margin:0;max-width:285px}
#flowlines-creation-pains .fl-pains__outro{text-align:center;font-size:clamp(20px,2vw,28px);font-weight:700;letter-spacing:-.025em;margin-top:75px}
#flowlines-creation-pains .fl-pains__outro span{color:#bd785f}
#flowlines-creation-pains .fl-pains__fallback{width:100%;height:100%;background:linear-gradient(135deg,#e1e2e0,#c8cccf)}
#flowlines-creation-pains .fl-pains__fallback span{position:absolute;left:18%;top:24%;width:64%;height:54%;border:2px solid #a4aaa9;border-radius:6px;transform:rotate(-7deg);background:#f0f0ec}
@media(max-width:990px){#flowlines-creation-pains .fl-pains__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 18px}}
@media(max-width:600px){#flowlines-creation-pains{padding:70px 20px 76px}#flowlines-creation-pains .fl-pains__intro{margin-bottom:38px}#flowlines-creation-pains .fl-pains__grid{gap:26px 12px}#flowlines-creation-pains .fl-pains__media{border-radius:12px;aspect-ratio:4/5}#flowlines-creation-pains h3{font-size:16px;margin:13px 0 6px}#flowlines-creation-pains .fl-pains__card>p{font-size:12px}#flowlines-creation-pains .fl-pains__number{left:12px;bottom:11px}#flowlines-creation-pains .fl-pains__outro{margin-top:50px}}
@media(prefers-reduced-motion:reduce){#flowlines-creation-pains img{transition:none!important}}
#flowlines-creation-pains .fl-pains__outro a{display:block;width:fit-content;margin:23px auto 0;font-size:14px;font-weight:700;letter-spacing:0;text-decoration:none;color:#333f47;border-bottom:1px solid #8e9ba0;padding-bottom:7px;transition:color .2s,transform .2s}
#flowlines-creation-pains .fl-pains__outro a:hover{color:#bd785f;transform:translateY(2px)}
</style>
{% schema %}
{"name":"Creative pain points","settings":[{"type":"image_picker","id":"image_1","label":"Card 1 image"},{"type":"image_picker","id":"image_2","label":"Card 2 image"},{"type":"image_picker","id":"image_3","label":"Card 3 image"},{"type":"image_picker","id":"image_4","label":"Card 4 image"}],"presets":[{"name":"Creative pain points"}]}
{% endschema %}

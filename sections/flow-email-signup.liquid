<section class="fl-signup" id="waitlist" aria-label="Flowlines early access email signup">
  <div class="fl-signup__inner">
    <div class="fl-signup__copy"><span>BE FIRST IN LINE</span><h2>Get early access to Flowlines.</h2><p>Creative updates, launch news, and first access — straight to your inbox.</p></div>
    <div class="fl-signup__form">
      {% form 'customer', id: 'FlowlinesEarlySignup' %}
        <input type="hidden" name="contact[tags]" value="newsletter,flowlines-early-access">
        <div class="fl-signup__fields">
          <label class="visually-hidden" for="FlowlinesSignupEmail-{{ section.id }}">Email address</label>
          <input id="FlowlinesSignupEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required aria-required="true" value="{{ form.email | escape }}">
          <button type="submit">Get Early Access <span aria-hidden="true">↗</span></button>
        </div>
        {% if form.posted_successfully? %}<p class="fl-signup__message" role="status">You're on the list. See you soon!</p>{% elsif form.errors %}<div class="fl-signup__message fl-signup__message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <p class="fl-signup__privacy">By subscribing, you agree to receive Flowlines emails.{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{% endif %}</p>
      {% endform %}
    </div>
  </div>
</section>
<style>
.fl-signup{background:#f5f7f8;color:#252b2e;padding:54px 28px;border-block:1px solid #e9edf0}
.fl-signup__inner{max-width:1420px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);align-items:center;gap:42px}
.fl-signup__copy>span{font-size:10px;letter-spacing:.2em;font-weight:800;color:#88786d}.fl-signup h2{font-size:clamp(25px,2.8vw,40px);letter-spacing:-.045em;line-height:1.12;margin:10px 0}.fl-signup__copy p{font-size:15px;color:#646b70;line-height:1.5;margin:0}
.fl-signup__fields{display:flex;gap:10px}.fl-signup__fields input{flex:1;min-width:0;height:58px;border-radius:11px;border:1px solid #d9e1e6;background:#fff;padding:0 19px;font-size:15px;color:#172631;outline-offset:3px}.fl-signup__fields input:focus-visible{outline:2px solid #d87550}.fl-signup__fields button{height:58px;border-radius:11px;border:0;padding:0 25px;background:#f5eaa2;color:#25231f;font-weight:750;font-size:14px;white-space:nowrap;cursor:pointer;transition:background .2s,transform .2s}.fl-signup__fields button:hover{background:#fff5ba;transform:translateY(-2px)}.fl-signup__fields button span{margin-left:6px}.fl-signup__privacy{font-size:11px;color:#8b969e;margin:13px 0 0;line-height:1.5}.fl-signup__privacy a{color:inherit;text-decoration:underline}.fl-signup__message{font-size:13px;color:#26764c;margin:11px 0 0}.fl-signup__message--error{color:#a23d31}
@media(max-width:900px){.fl-signup__inner{grid-template-columns:1fr;gap:25px}.fl-signup{padding:44px 20px}}@media(max-width:540px){.fl-signup{padding:38px 16px}.fl-signup__fields{flex-direction:column}.fl-signup__fields button,.fl-signup__fields input{width:100%}.fl-signup__copy p{font-size:14px}}
</style>
{% schema %}
{"name":"Flowlines email signup","settings":[],"presets":[{"name":"Flowlines email signup"}]}
{% endschema %}
